{
 "cells": 
  {
   "cell_type": "markdown",
   "id": "3111f2e9",
   "metadata": {},
   "source": [
    "## 3 new, exciting code generation ideas - \n",
    "a. A code tool that automatically adds docstring/ comments.\n",
    "\n",
    "b. A code gen tool that writes unnit test cases.\n",
    "\n",
    "c. A code generator that writes trading code to buy and sell equities in a simulated environment, based on a given API"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "9a17c42d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# AI CODE GENERATION SUITE\n",
    "# FEATURES:\n",
    "# 1. Add Docstrings + Comments\n",
    "# 2. Generate Unit Tests\n",
    "# 3. Generate Trading Bots\n",
    "#\n",
    "# MODELS:\n",
    "# - Groq -> llama-3.3-70b-versatile\n",
    "# - Gemini -> gemini-2.5-flash-lite\n",
    "#\n",
    "# UI:\n",
    "# - Gradio\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "from dotenv import load_dotenv\n",
    "from openai import OpenAI\n",
    "import gradio as gr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "f6d5ad72",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# LOAD ENV\n",
    "# ============================================================\n",
    "\n",
    "load_dotenv()\n",
    "\n",
    "groq_api_key = os.getenv(\"GROQ_API_KEY\")\n",
    "google_api_key = os.getenv(\"GOOGLE_API_KEY\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "63a280c0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CLIENTS\n",
    "# ============================================================\n",
    "\n",
    "groq = OpenAI(\n",
    "    api_key=groq_api_key,\n",
    "    base_url=\"https://api.groq.com/openai/v1\"\n",
    ")\n",
    "\n",
    "gemini = OpenAI(\n",
    "    api_key=google_api_key,\n",
    "    base_url=\"https://generativelanguage.googleapis.com/v1beta/openai/\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "c1cd0d6c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# MODELS\n",
    "# ============================================================\n",
    "\n",
    "MODELS = {\n",
    "    \"Groq\": \"llama-3.3-70b-versatile\",\n",
    "    \"Gemini\": \"gemini-2.5-flash-lite\"\n",
    "}\n",
    "\n",
    "CLIENTS = {\n",
    "    \"Groq\": groq,\n",
    "    \"Gemini\": gemini\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "e1fbf228",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# SYSTEM PROMPTS\n",
    "# ============================================================\n",
    "\n",
    "DOCSTRING_PROMPT = \"\"\"\n",
    "You are an expert software engineer.\n",
    "\n",
    "Your task:\n",
    "- Add professional docstrings\n",
    "- Add inline comments\n",
    "- Improve readability\n",
    "- Keep functionality EXACTLY the same\n",
    "\n",
    "Return ONLY valid code.\n",
    "\"\"\"\n",
    "\n",
    "UNIT_TEST_PROMPT = \"\"\"\n",
    "You are a senior QA automation engineer.\n",
    "\n",
    "Generate:\n",
    "- pytest unit tests\n",
    "- edge cases\n",
    "- invalid inputs\n",
    "- production-quality tests\n",
    "\n",
    "Return ONLY valid Python pytest code.\n",
    "\"\"\"\n",
    "\n",
    "TRADING_PROMPT = \"\"\"\n",
    "You are an expert quantitative trading engineer.\n",
    "\n",
    "Generate:\n",
    "- production-ready trading bots\n",
    "- risk management\n",
    "- stop loss\n",
    "- take profit\n",
    "- clean architecture\n",
    "\n",
    "Use a SIMULATED trading environment only.\n",
    "\n",
    "Return ONLY valid Python code.\n",
    "\"\"\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "dd30c833",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# GENERATION FUNCTION\n",
    "# ============================================================\n",
    "\n",
    "def generate(task, model_name, user_input):\n",
    "\n",
    "    client = CLIENTS[model_name]\n",
    "    model = MODELS[model_name]\n",
    "\n",
    "    # ========================================================\n",
    "    # SELECT PROMPT\n",
    "    # ========================================================\n",
    "\n",
    "    if task == \"Add Docstrings + Comments\":\n",
    "        system_prompt = DOCSTRING_PROMPT\n",
    "\n",
    "    elif task == \"Generate Unit Tests\":\n",
    "        system_prompt = UNIT_TEST_PROMPT\n",
    "\n",
    "    else:\n",
    "        system_prompt = TRADING_PROMPT\n",
    "\n",
    "    # ========================================================\n",
    "    # API CALL\n",
    "    # ========================================================\n",
    "\n",
    "    response = client.chat.completions.create(\n",
    "        model=model,\n",
    "        messages=[\n",
    "            {\n",
    "                \"role\": \"system\",\n",
    "                \"content\": system_prompt\n",
    "            },\n",
    "            {\n",
    "                \"role\": \"user\",\n",
    "                \"content\": user_input\n",
    "            }\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    result = response.choices[0].message.content\n",
    "\n",
    "    # remove markdown\n",
    "    result = (\n",
    "        result\n",
    "        .replace(\"```python\", \"\")\n",
    "        .replace(\"```\", \"\")\n",
    "        .strip()\n",
    "    )\n",
    "\n",
    "    return result"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "d46bdcf9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# SAMPLE INPUTS\n",
    "# ============================================================\n",
    "\n",
    "sample_code = \"\"\"\n",
    "def add(a,b):\n",
    "    return a+b\n",
    "\"\"\"\n",
    "\n",
    "sample_strategy = \"\"\"\n",
    "Create a moving average crossover strategy.\n",
    "\n",
    "BUY:\n",
    "- 50 EMA crosses above 200 EMA\n",
    "\n",
    "SELL:\n",
    "- 50 EMA crosses below 200 EMA\n",
    "\n",
    "Risk Management:\n",
    "- stop loss 2%\n",
    "- take profit 5%\n",
    "\"\"\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "5455022d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# UI\n",
    "# ============================================================\n",
    "\n",
    "with gr.Blocks(\n",
    "    theme=gr.themes.Monochrome(),\n",
    "    title=\"AI Code Generation Suite\"\n",
    ") as ui:\n",
    "\n",
    "    gr.Markdown(\n",
    "        \"# AI Code Generation Suite\"\n",
    "    )\n",
    "\n",
    "    # ========================================================\n",
    "    # CONTROLS\n",
    "    # ========================================================\n",
    "\n",
    "    with gr.Row():\n",
    "\n",
    "        task = gr.Dropdown(\n",
    "            [\n",
    "                \"Add Docstrings + Comments\",\n",
    "                \"Generate Unit Tests\",\n",
    "                \"Generate Trading Bot\"\n",
    "            ],\n",
    "            value=\"Add Docstrings + Comments\",\n",
    "            label=\"Task\"\n",
    "        )\n",
    "\n",
    "        model = gr.Dropdown(\n",
    "            [\"Groq\", \"Gemini\"],\n",
    "            value=\"Groq\",\n",
    "            label=\"Model\"\n",
    "        )\n",
    "\n",
    "    # ========================================================\n",
    "    # INPUT\n",
    "    # ========================================================\n",
    "\n",
    "    user_input = gr.Code(\n",
    "        label=\"Input\",\n",
    "        value=sample_code,\n",
    "        language=\"python\",\n",
    "        lines=20\n",
    "    )\n",
    "\n",
    "    # ========================================================\n",
    "    # BUTTONS\n",
    "    # ========================================================\n",
    "\n",
    "    with gr.Row():\n",
    "\n",
    "        use_code_sample = gr.Button(\"Load Code Sample\")\n",
    "\n",
    "        use_strategy_sample = gr.Button(\"Load Strategy Sample\")\n",
    "\n",
    "        generate_btn = gr.Button(\"Generate\")\n",
    "\n",
    "    # ========================================================\n",
    "    # OUTPUT\n",
    "    # ========================================================\n",
    "\n",
    "    output = gr.Code(\n",
    "        label=\"Generated Output\",\n",
    "        language=\"python\",\n",
    "        lines=25\n",
    "    )\n",
    "\n",
    "    # ========================================================\n",
    "    # SAMPLE LOADERS\n",
    "    # ========================================================\n",
    "\n",
    "    def load_code_sample():\n",
    "        return sample_code\n",
    "\n",
    "    def load_strategy_sample():\n",
    "        return sample_strategy\n",
    "\n",
    "    use_code_sample.click(\n",
    "        fn=load_code_sample,\n",
    "        outputs=[user_input]\n",
    "    )\n",
    "\n",
    "    use_strategy_sample.click(\n",
    "        fn=load_strategy_sample,\n",
    "        outputs=[user_input]\n",
    "    )\n",
    "\n",
    "    # ========================================================\n",
    "    # GENERATE\n",
    "    # ========================================================\n",
    "\n",
    "    generate_btn.click(\n",
    "        fn=generate,\n",
    "        inputs=[task, model, user_input],\n",
    "        outputs=[output]\n",
    "    )"
   ]
  },
  {
